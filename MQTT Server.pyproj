    <Content Include="src\CgMosqCtl\CgMosqCtl.csproj" />
    <Content Include="src\CgMosqCtl\ConfigLoader.cs" />
    <Content Include="src\CgMosqCtl\Log.cs" />
    <Content Include="src\CgMosqCtl\Program.cs" />
